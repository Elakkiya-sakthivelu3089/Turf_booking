generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HEAD
  EMPLOYEE
}

enum CategoryType {
  INDOOR
  OUTDOOR
}

enum TeamName {
  TEAM_A
  TEAM_B
}

enum BookingStatus {
  BOOKED
  CANCELLED
  PLAYED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())

  headedGames Game[]          @relation("GameHead")
  joinedTeams BookingPlayer[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      CategoryType
  games     Game[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Game {
  id          Int      @id @default(autoincrement())
  name        String
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  isActive    Boolean  @default(true)
  headId      Int?
  head        User?    @relation("GameHead", fields: [headId], references: [id], onDelete: SetNull)

  teamALimit  Int      @default(1)
  teamBLimit  Int      @default(1)

  bookings    Booking[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id        Int      @id @default(autoincrement())

  gameId    Int

  date      DateTime
  startTime String
  endTime   String

  game      Game     @relation(fields: [gameId], references: [id])
  players   BookingPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, date, startTime, endTime])
}
model BookingPlayer {
  id Int @id @default(autoincrement())

  bookingId Int
  userId    Int
  team      TeamName
  status    BookingStatus @default(BOOKED)

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  date      DateTime
  startTime String
  endTime   String

  createdAt DateTime @default(now())

  @@unique([userId, date, startTime, endTime])
  @@unique([bookingId, userId])
}
